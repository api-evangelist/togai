          "id": "6a1ccb12-99a8-4b8a-a9e4-2795af48d152",
          "name": "Generate Short Lived Bearer Token",
          "request": {
            "name": "Generate Short Lived Bearer Token",
            "description": {
              "content": "Generates and returns a bearer token. Behavior of this API differs on the basis of the auth mechanism used to make the request.\n  - For API key auth, this API generates a JWT token whcih is valid for 24 hours and returns it.\n  - For JWT bearer auth, returns the same JWT token in response\nFor information on how to generate API token, refer [Generating New API Keys](https://docs.togai.com/api-reference/authentication#generating-new-api-keys) section of docs.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authenticate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "558597af-5aad-47b5-802b-fe35a7d143b1",
              "name": "OK",
              "originalRequest": {
                "url": {
