          "name": "Get Togai Metrics",
          "request": {
            "name": "Get Togai Metrics",
            "description": {
              "content": "Togai Metrics API allows you to fetch different metrics from Events, Usage Meters and PricePlans with multiple queryable options.\nA single request can query up to five metrics. \nSingle response can contain a maximum of 300 data points.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"<dateTime>\",\n  \"endTime\": \"<dateTime>\",\n  \"metricQueries\": [\n    {\n      \"id\": \"<string>\",\n      \"name\": \"EVENTS\",\n      \"aggregationPeriod\": \"DAY\",\n      \"groupBy\": \"<string>\",\n      \"configs\": {\n        \"key_0\": \"<string>\",\n        \"key_1\": \"<string>\"\n      },\n      \"filters\": [\n        {\n          \"fieldName\": \"<string>\",\n          \"fieldValues\": [\n            \"<string>\",\n            \"<string>\"\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"<string>\",\n      \"name\": \"EVENTS\",\n      \"aggregationPeriod\": \"DAY\",\n      \"groupBy\": \"<string>\",\n      \"configs\": {\n        \"key_0\": \"<string>\",\n        \"key_1\": \"<string>\",\n        \"key_2\": \"<string>\"\n      },\n      \"filters\": [\n        {\n          \"fieldName\": \"<string>\",\n          \"fieldValues\": [\n            \"<string>\",\n            \"<string>\"\n          ]\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
